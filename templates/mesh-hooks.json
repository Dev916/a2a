{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "S=$(jq -r '.session_id // empty' 2>/dev/null); a2a mesh register --session \"$S\" && a2a mesh inject --session \"$S\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "S=$(jq -r '.session_id // empty' 2>/dev/null); a2a mesh heartbeat --session \"$S\" && a2a mesh inject --session \"$S\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "S=$(jq -r '.session_id // empty' 2>/dev/null); a2a mesh retire --session \"$S\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
