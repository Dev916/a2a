#!/bin/sh
# stub-codex: scripted `codex exec --json` stand-in.
# Env knobs: STUB_SLEEP, STUB_EXIT, STUB_LAST_MSG, STUB_NO_RESULT, STUB_LEAK,
#            STUB_RESULT_LAG (seconds --output-last-message trails turn.completed),
#            STUB_EMIT_QUESTION, STUB_MESH_NOTE, STUB_RECORD (dir for resume recordings), STUB_RESUME_FAIL
#            STUB_ARGV_FILE (file; the whole argv, every run),
#            STUB_PWD_FILE (file; this child's own working directory)
#            STUB_WRITE (space-separated paths, relative to the `-C` workspace;
#                        each is written with "stub\n" — the worker's "change")
out=""; outbox=""; resume=0; cdir=""
argv="$*"   # captured before the parse loop consumes it — resume-argv.txt is the ps-safety witness
[ "$1" = "exec" ] && shift
while [ $# -gt 0 ]; do
  case "$1" in
    # `resume` is a SUBCOMMAND of `codex exec` and real codex parses every
    # exec-level option BEFORE it, so it can appear anywhere after `exec`
    # (a2a emits it last, just before the `-`). The trailing shift below eats
    # the session id that follows it.
    resume)                resume=1;;
    --output-last-message) shift; out="$1";;
    --add-dir)             shift; outbox="$1";;
    -C)                    shift; cdir="$1";;
  esac; shift
done
# STUB_ARGV_FILE: the whole argv, every run — the witness for `-C <workspace>`
# (a2a derives it from the worker's cwd, so a worktree spawn must land here).
[ -n "$STUB_ARGV_FILE" ] && printf '%s\n' "$argv" > "$STUB_ARGV_FILE"
# STUB_PWD_FILE: this child's own working directory — the witness that the shim
# sets the WORKER DIR as cwd and the workspace travels ONLY in `-C` (a2a never
# calls current_dir on the codex child, which is deliberate, not an oversight).
[ -n "$STUB_PWD_FILE" ] && pwd > "$STUB_PWD_FILE"
if [ "$resume" = 1 ] && [ -n "$STUB_RECORD" ]; then
  printf '%s\n' "$0 $argv" > "$STUB_RECORD/resume-argv.txt"
  cat > "$STUB_RECORD/resume-stdin.txt"
fi
[ -n "$STUB_RESUME_FAIL" ] && [ "$resume" = 1 ] && exit "$STUB_RESUME_FAIL"
printf '%s\n' '{"type":"session.created","session_id":"stub-sess-1"}'
printf '%s\n' '{"type":"turn.started","id":"t1"}'
# A STUB_NO_RESULT turn says nothing at all: real codex records ANY final agent
# message via --output-last-message, so "no result" means "no agent message".
if [ -z "$STUB_NO_RESULT" ]; then
  printf '%s\n' "{\"type\":\"agent_message\",\"message\":\"working ${STUB_LEAK:-}\"}"
fi
printf '%s\n' '{"type":"agent_message_delta","delta":"x"}'
if [ -n "$STUB_DUMP_ENV" ]; then env > "$STUB_DUMP_ENV"; fi
[ -n "$STUB_SLEEP" ] && sleep "$STUB_SLEEP"
if [ -n "$STUB_WRITE" ] && [ -n "$cdir" ]; then
  for _f in $STUB_WRITE; do
    mkdir -p "$cdir/$(dirname "$_f")" && printf 'stub\n' > "$cdir/$_f"
  done
fi
if [ -n "$STUB_EMIT_QUESTION" ] && [ -n "$outbox" ]; then
  printf '%s\n' '{"seq":1,"question":"A or B?","blocking":true}' > "$outbox/1.question.json"
fi
if [ -n "$STUB_MESH_NOTE" ] && [ -n "$outbox" ]; then
  printf '%s\n' "$STUB_MESH_NOTE" > "$outbox/1.note.json"
fi
# Faithful to real codex: the turn's FINAL agent message is exactly what
# --output-last-message records, so a result synthesized from the event stream
# matches the file byte for byte. Emitted only when a result is produced (a
# question turn parks with no result). JSON-escape the value so a JSON result
# (e.g. a --schema payload) stays a valid message string.
if [ -z "$STUB_NO_RESULT" ] && [ -z "$STUB_EMIT_QUESTION" ]; then
  _resc=$(printf '%s' "${STUB_LAST_MSG:-done}" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '%s\n' "{\"type\":\"agent_message\",\"message\":\"$_resc\"}"
fi
printf '%s\n' '{"type":"turn.completed","id":"t1"}'
# STUB_RESULT_LAG: codex 0.152 flushes --output-last-message a few hundred ms
# AFTER turn.completed, with the process still alive.
[ -n "$STUB_RESULT_LAG" ] && sleep "$STUB_RESULT_LAG"
if [ -n "$out" ] && [ -z "$STUB_NO_RESULT" ] && [ -z "$STUB_EMIT_QUESTION" ]; then
  printf '%s\n' "${STUB_LAST_MSG:-done}" > "$out"
fi
exit "${STUB_EXIT:-0}"
